{
  "name": "browser",
  "productName": "Browser",
  "version": "0.1.0",
  "private": true,
  "description": "A personal, Arc-style browser built on Electron",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac": "electron-vite build && electron-builder --mac --universal",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac --arm64",
    "dist:mac:x64": "electron-vite build && electron-builder --mac --x64"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "tldts-experimental": "^7.5.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "author": "sujalsin",
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "adm-zip": "^0.6.1"
  }
}
